<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit estate.property form to add Invoice page -->
    <record id="estate_property_form_invoice_page" model="ir.ui.view">
        <field name="name">estate.property.form.invoice.page</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice" invisible="state != 'sold'">
                    <group>
                        <field name="invoice_ids"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_property_field" model="ir.ui.view">
        <field name="name">account.move.form.inherit.property.field</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <label for="property_id" string="Property" invisible="move_type != 'out_invoice'"/>
                <div name="property_div" class="d-flex" invisible="move_type != 'out_invoice'">
                    <field name="property_id" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_send_button" model="ir.ui.view">
        <field name="name">account.move.form.inherit.send.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- First Send Button -->
            <xpath expr="//button[@name='action_invoice_sent'][1]" position="attributes">
                <attribute name="groups">estate.group_estate_accountant,estate.group_estate_manager</attribute>
            </xpath>

            <!-- Second Send Button -->
            <xpath expr="//button[@name='action_invoice_sent'][2]" position="attributes">
                <attribute name="groups">estate.group_estate_accountant,estate.group_estate_manager</attribute>
            </xpath>

        </field>
    </record>

</odoo>
