<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit estate.property form to add Invoice page -->
    <record id="estate_property_form_invoice_page" model="ir.ui.view">
        <field name="name">estate.property.form.invoice.page</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice" invisible="state != 'sold'">
                    <group>
                        <field name="invoice_ids"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>