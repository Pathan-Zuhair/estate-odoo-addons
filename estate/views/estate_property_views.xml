<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state in ('offer_received', 'offer_accepted')"
                decoration-bf="state == 'offer_accepted'"
                decoration-muted="state == 'sold'"
                decoration-danger="state == 'cancelled'">

                <field name="name"/>
                <field name="state"/>
                <field name="property_type_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="expected_price"/>
                <field name="date_availability" optional="hide"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">

                <header>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>

                    <button name="action_sold"
                            type="object"
                            string="Sold"
                            class="btn-primary"
                            groups="estate.group_estate_admin"
                            invisible="state in ('sold','cancelled')"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            groups="estate.group_estate_admin"
                            invisible="state in ('sold','cancelled')"/>

                    <button name="action_sold"
                            type="object"
                            string="Sold"
                            class="btn-primary"
                            groups="estate.group_estate_seller"
                            invisible="state != 'offer_accepted'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            groups="estate.group_estate_seller"
                            invisible="state in ['sold','cancelled','offer_accepted']"/>

                </header>

                <sheet>

                    <widget name="web_ribbon"
                            title="Sold"
                            bg_color="bg-success"
                            invisible="state != 'sold'"/>

                    <widget name="web_ribbon"
                            title="Cancelled"
                            bg_color="bg-secondary"
                            invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="state" readonly="1" groups="estate.group_estate_buyer"/>
                            <field name="state" groups="estate.group_estate_admin" readonly="0"/>
                            <field name="state" readonly="1" groups="estate.group_estate_seller"/>

                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="property_type_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>

                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price" readonly="1"/>
                        </group>
                    </group>

                    <group string="Property Details">
                        <group>
                            <field name="bedrooms"/>
                            <field name="facades"/>
                        </group>
                        <group>
                            <field name="garage"/>
                            <field name="garden"/>
                            <field name="garden_orientation" invisible="not garden"/>
                        </group>
                    </group>

                    <group string="Area">
                        <label for="living_area" string="Living Area"/>
                        <div class="o_row">
                            <field name="living_area" class="oe_inline"/>
                            <span class="me-2">sqm</span>
                            <span invisible="not garden" class="mx-3">+</span>
                            <span invisible="not garden" class="me-2">Garden Area:</span>
                            <field name="garden_area" class="oe_inline" invisible="not garden"/>
                            <span invisible="not garden">sqm</span>
                        </div>

                        <label for="total_area" string="Total Area"/>
                        <div class="o_row">
                            <div style="display: inline-block;">
                                <field name="total_area" readonly="1" class="oe_inline"/>
                                <span class="ms-2">sqm</span>
                            </div>
                        </div>
                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"/>
                        </page>

                        <page string="Sales">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id" readonly="1"/>
                            </group>
                        </page>

                        <page string="Offers">

                            <field name="offer_ids"
                                   context="{'default_partner_id': uid}"
                                   groups="estate.group_estate_admin">

                                <list editable="bottom"
                                      decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused' or property_state == 'cancelled'">

                                    <field name="property_state" optional="hide"/>
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>

                                    <button name="action_accept"
                                            type="object"
                                            icon="fa-check"
                                            class="btn-primary"
                                            groups="estate.group_estate_admin"
                                            invisible="status in ['accepted','refused']"/>

                                    <button name="action_refuse"
                                            type="object"
                                            icon="fa-times"
                                            class="btn-secondary"
                                            groups="estate.group_estate_admin"
                                            invisible="status in ['accepted','refused']"/>

                                </list>
                            </field>

                            <field name="offer_ids"
                                   context="{'default_partner_id': uid}"
                                   groups="estate.group_estate_buyer"
                                   readonly="state in ['sold','cancelled']">

                                <list editable="bottom" delete="false"
                                      decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused' or property_state == 'cancelled'">

                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status" readonly="1"/>

                                    <button name="action_delete_offer"
                                            type="object"
                                            icon="fa-trash"
                                            class="btn-link text-danger ms-5"
                                            invisible="status in ('accepted','refused') or property_state != 'offer_received' or create_uid != uid"/>

                                </list>
                            </field>

                            <field name="offer_ids" groups="estate.group_estate_seller">

                                <list edit="true"
                                      decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused' or property_state == 'cancelled'">

                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>

                                    <button name="action_accept"
                                            type="object"
                                            icon="fa-check"
                                            class="btn-primary"
                                            invisible="status == 'accepted' or property_state in ['sold','cancelled']"/>

                                    <button name="action_refuse"
                                            type="object"
                                            icon="fa-times"
                                            class="btn-secondary"
                                            invisible="status == 'refused' or property_state in ['sold','cancelled']"/>

                                </list>
                            </field>

                            <field name="offer_ids" groups="estate.group_estate_accountant">
                                <list create="false" edit="false" delete="false"
                                      decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused' or property_state == 'cancelled'">

                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>

                                </list>
                            </field>

                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="postcode"/>
                <field name="state"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="expected_price"/>
                <field name="property_type_id"/>

                <filter string="Available" name="available" domain="[('state','in',('new','offer_received'))]"/>
                <filter string="Sold" name="sold" domain="[('state','=','sold')]"/>

                <filter string="Group by State" name="group_by_state" context="{'group_by':'state'}"/>
                <filter string="Group by Bedrooms" name="group_by_bedrooms" context="{'group_by':'bedrooms'}"/>
                <filter string="Group by Postcode" name="group_by_postcode" context="{'group_by':'postcode'}"/>

            </search>
        </field>
    </record>

    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban group_create="false" group_edit="false" group_delete="false" class="o_kanban_color">

                <field name="name"/>
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="tag_ids"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record oe_kanban_color_#{record.color.raw_value} position-relative overflow-hidden">

                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>

                            <div class="mt8">

                                <div>
                                    <strong>Expected:</strong>
                                    <field name="expected_price"/>
                                </div>

                                <div t-if="record.state.raw_value == 'offer_received'">
                                    <strong>Best Offer:</strong>
                                    <field name="best_price"/>
                                </div>

                                <div t-if="record.state.raw_value == 'offer_accepted'">
                                    <strong>Selling Price:</strong>
                                    <field name="selling_price"/>
                                </div>

                                <div t-if="record.state.raw_value == 'sold'">
                                    <strong>Sold Price:</strong>
                                    <field name="selling_price"/>
                                </div>

                            </div>

                            <div class="mt8">
                                <field name="tag_ids"
                                       widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">
            {'search_default_available': 1, 'group_by': 'property_type_id'}
        </field>
    </record>

    <record id="action_estate_property_sold_invoices" model="ir.actions.act_window">
        <field name="name">Sold Property Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'),('property_sold','=',True)]</field>
        <field name="context">{'default_move_type':'out_invoice'}</field>
    </record>

</odoo>