<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- Offer List (List) View -->
    <!-- ========================= -->
    <record id="estate_property_offer_list_view" model="ir.ui.view">
    <field name="name">estate.property.offer.list</field>
    <field name="model">estate.property.offer</field>
    <field name="arch" type="xml">
        <list editable="bottom"
              decoration-success="status == 'accepted'"
              decoration-danger="status == 'refused' or property_state == 'cancelled'">

            <!-- REQUIRED FIELDS FOR DECORATION -->
            <field name="status" invisible="1"/>
            <field name="property_type_id"/>
<!--            <field name="property_state" invisible="1"/>-->

            <field name="price"/>
            <field name="partner_id"/>
            <field name="validity"/>
            <field name="date_deadline"/>

            <button name="action_accept"
                    type="object"
                    icon="fa-check"
                    class="btn-primary"
                    groups="estate.group_estate_manager"
                    invisible="status in ('accepted','refused')"/>

            <button name="action_refuse"
                    type="object"
                    icon="fa-times"
                    class="btn-secondary"
                    groups="estate.group_estate_manager"
                    invisible="status in ('accepted','refused')"/>

        </list>
    </field>
</record>


    <!-- ========================= -->
    <!-- Offer Form View -->
    <!-- ========================= -->
    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <sheet>

                    <group>
                        <group>
                            <field name="price"/>
                            <field name="status" readonly="1"/>
                        </group>

                        <group>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                        </group>
                    </group>

                    <group>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Action -->
    <!-- ========================= -->
    <record id="action_estate_property_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>

        <field name="domain">
        [('property_type_id', '=', active_id)]
        </field>

    </record>

</odoo>