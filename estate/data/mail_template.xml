<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_offer_accepted" model="mail.template">
            <field name="name">Offer Accepted</field>
            <field name="model_id" ref="model_estate_property_offer"/>
            <field name="subject">Offer Accepted</field>
            <field name="email_to">${object.buyer_id.email or ''}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Hello ${object.partner_id.name or ''},</p>
                    <p>Your offer has been <strong>ACCEPTED</strong> for <strong>${object.property_id.name}</strong>.</p>
                    <p>Offer price: <strong>${object.price}</strong></p>
                </div>
            </field>
        </record>

        <record id="mail_template_offer_refused" model="mail.template">
            <field name="name">Offer Refused</field>
            <field name="model_id" ref="model_estate_property_offer"/>
            <field name="subject">Offer Refused</field>
            <field name="email_to">${object.partner_id.email or ''}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Hello ${object.partner_id.name or ''},</p>
                    <p>Your offer has been <strong>REFUSED</strong> for <strong>${object.property_id.name}</strong>.</p>
                    <p>Offer price: <strong>${object.price}</strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
