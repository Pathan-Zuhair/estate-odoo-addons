<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <delete model="ir.rule" id="rule_offer_manager_only"/>

    <!-- Covers Estate User and Manager (manager implies Estate User). -->
    <record id="rule_offer_user" model="ir.rule">
        <field name="name">Estate Offer: estate users</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[(4, ref('estate.group_estate_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
