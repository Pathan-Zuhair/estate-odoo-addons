    <record id="rule_estate_offer_user_read" model="ir.rule">
        <field name="name">Estate Offer User Read All</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[(4, ref('estate.group_estate_user'))]"/>

        <!--  SEE ALL -->
        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_estate_offer_user_own" model="ir.rule">
        <field name="name">Estate Offer User Own</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[(4, ref('estate.group_estate_user'))]"/>

        <!--  ONLY OWN -->
        <field name="domain_force">[('create_uid', '=', user.id)]</field>

        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


    <record id="rule_estate_offer_seller" model="ir.rule">
        <field name="name">Estate Offer Seller</field>
        <field name="model_id" ref="model_estate_property_offer"/>
        <field name="groups" eval="[(4, ref('estate.group_estate_seller'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
